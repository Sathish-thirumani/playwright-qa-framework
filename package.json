{
  "name": "playwright-qa-framework",
  "version": "1.0.0",
  "description": "API and UI test automation framework in TypeScript with Playwright, run in CI with GitHub Actions",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium --project=ui-firefox",
    "test:api": "playwright test --project=api",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
